# =========================
# Django Configuration
# =========================

# SECURITY WARNING: Generate a new secret key for production!
# You can generate one at: https://djecrety.ir/
SECRET_KEY=django-insecure-generate-a-new-secret-key-for-production

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts
# Example: ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost
ALLOWED_HOSTS=localhost,127.0.0.1

# =========================
# Database (Optional)
# =========================

# Default is SQLite. For PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# =========================
# Frontend Configuration
# =========================

# React frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# =========================
# Face Recognition Settings
# =========================

# Tolerance for face matching (0.0 - 1.0, lower is stricter)
FACE_MATCH_TOLERANCE=0.5
